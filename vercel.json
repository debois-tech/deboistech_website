{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/lib/pages/services.html", "destination": "/services", "permanent": true },
    { "source": "/lib/pages/products.html", "destination": "/products", "permanent": true },
    { "source": "/lib/pages/about.html", "destination": "/about", "permanent": true },
    { "source": "/lib/pages/blogs.html", "destination": "/blogs", "permanent": true },
    { "source": "/lib/pages/blog-detail.html", "destination": "/blogs", "permanent": true },
    { "source": "/lib/pages/blog-studio.html", "destination": "/blogs", "permanent": true },
    { "source": "/lib/pages/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/lib/pages/careers.html", "destination": "/careers", "permanent": true },
    { "source": "/lib/pages/faq.html", "destination": "/faq", "permanent": true },
    { "source": "/lib/pages/privacypolicy.html", "destination": "/privacy-policy", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
